{
  "name": "mysnapdrop-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "electron:start": "electron .",
    "electron:dev": "npm run dev:electron",
    "dev:electron": "concurrently \"cd server && node index.js\" \"cd client && npm run dev\" \"cross-env ELECTRON_DEV=true electron .\"",
    "build:client": "cd client && npm run build",
    "electron:build": "npm run build:client && electron-builder"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.mysnapdrop.app",
    "productName": "MySnapDrop",
    "files": [
      "electron/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist_electron"
    }
  }
}

